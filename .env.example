# ---------------------------------------------------------------------------
# .env.example — copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and never leaves your machine.
# On Netlify, add the same variables under Site settings → Environment.
# ---------------------------------------------------------------------------

# Neon → your project → "Connection string" (use the POOLED one for production).
# Any PostgreSQL URL works locally too (e.g. postgres://postgres:postgres@localhost:5432/portfolio).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# A long random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# The very first admin account. Used ONLY by `npm run db:seed` to create the
# user; after that you log in with these and can change the password in /admin.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Cloudinary → Dashboard → "Product environment credentials".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder inside Cloudinary where uploads are stored (any name you like).
CLOUDINARY_FOLDER="portfolio"

# Public URL of the site (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL="https://noorullahtech.netlify.app"
