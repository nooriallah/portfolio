# ---------------------------------------------------------------------------
# .env.example — TEMPLATE ONLY.
#
# Copy this file to `.env.local` and put the real values THERE.
# `.env.local` is git-ignored and never leaves your machine.
# On Netlify, add the same variables under
#   Site configuration → Environment variables.
#
# ⚠ NEVER put real values in THIS file. It is committed to git, so anything
#   written here is public to anyone with repo access — and Netlify's secret
#   scanner will fail the build when a real value shows up in a repo file.
# ---------------------------------------------------------------------------

# Neon → your project → "Connection string" (use the POOLED one for production).
# Any PostgreSQL URL works locally too, e.g.
#   postgres://postgres:postgres@localhost:5432/portfolio
DATABASE_URL=

# A long random string used to sign the admin session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The very first admin account. Used ONLY by `npm run db:seed` to create the
# user; after that you log in with these and can change the password in /admin.
# These two are NOT needed on Netlify.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary → Dashboard → "Product environment credentials".
# The cloud name is the short name at the top of the dashboard; the API key and
# secret are the pair underneath it. You can instead paste the single line
# Cloudinary offers, as CLOUDINARY_URL="cloudinary://KEY:SECRET@CLOUD_NAME".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder inside Cloudinary where uploads are stored (any name you like).
# Leave empty to use the default, "portfolio".
CLOUDINARY_FOLDER=

# Public URL of the site, used for metadata / Open Graph. For example
# http://localhost:3000 locally, and your real domain on Netlify.
NEXT_PUBLIC_SITE_URL=
